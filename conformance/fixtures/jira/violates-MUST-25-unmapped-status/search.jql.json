    {
      "id": "10004",
      "key": "WOJ-4",
      "fields": {
        "summary": "The nightly export runs without anyone triggering it",
        "status": {
          "name": "Awaiting Deployment",
          "statusCategory": {
            "key": "indeterminate"
          }
        },
        "labels": [
          "export",
          "ops"
        ],
        "issuelinks": [],
        "created": "2026-09-12T09:14:03.117-0400",
        "updated": "2026-09-14T16:02:55.412-0400",
        "issuetype": {
          "name": "Task"
        },
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Problem"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The export runs when somebody remembers, so the file consumers read is between one and nine days old."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Solution"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ship a timer and service unit that run the export nightly and write the result where consumers already read it."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Out of scope"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Alerting on a missed run, and any change to the export's contents."
                }
              ]
            }
          ]
        },
        "customfield_11001": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "deploy/export.timer"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "deploy/export.service"
                }
              ]
            }
          ]
        },
        "customfield_11002": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "systemd-analyze verify deploy/export.service"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "test -s \"$(ls -t /var/log/ex/export-*.csv | head -1)\""
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "# Today deploy/export.service does not exist, so the first check fails."
                }
              ]
            }
          ]
        },
        "customfield_11003": null,
