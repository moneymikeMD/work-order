        "issuetype": {
          "name": "Task"
        },
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2
              },
              "content": [
                {
                  "type": "text",
                  "text": "Problem"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The committed example env file carries a real bucket key rather than an empty placeholder."
                }
              ]
            },
            {
              "type": "heading",
